    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "xlsx": "^0.18.5",
    "resend": "^4.5.1",
    "winston": "^3.19.0",
