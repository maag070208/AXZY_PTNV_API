generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  AREA_HEAD
  EMPLOYEE
  HUMAN_RESOURCES
  GUARD
}

enum DiscountType {
  INFONAVIT
  IMSS
  CHILD_SUPPORT
}

enum DisciplinaryReason {
  ABSENCE
  TARDINESS
  INTOXICATION
  MISCONDUCT
  NONCOMPLIANCE
  OTHER
}

enum MaterialOutputReason {
  DAMAGED
  OBSOLETE
  LOST
  OTHER
}

// Estado de una unidad física de inventario.
enum DeviceUnitStatus {
  AVAILABLE
  ON_LOAN
  DAMAGED
  IN_MAINTENANCE
  RETIRED
}

// Tipos de movimiento de inventario (cabecera + detalles).
enum MovementType {
  STOCK_IN
  LOAN
  RETURN
  RETIREMENT
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  MAINTENANCE_IN
  MAINTENANCE_OUT
  REVERSAL
}

enum MovementStatus {
  ACTIVE
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  PARTIAL
  RETURNED
  CANCELLED
}

enum ItemCondition {
  GOOD
  FAIR
  POOR
  BROKEN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

// Control de acceso (entradas/salidas de personal con credencial).
enum AccessEventType {
  ENTRY
  EXIT
}

// Cómo se obtuvo el "dónde" del escaneo: GPS del dispositivo, solo el sitio
// del catálogo, o captura manual (reservado, no usado en MVP).
enum AccessLocationSource {
  GPS
  SITE_ONLY
  MANUAL
}

// Medio por el que se registró el evento.
enum AccessMethod {
  QR_SCAN
  MANUAL
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subareas    Subarea[]
  users       User[]
  tickets     Ticket[]
  deviceUnits DeviceUnit[]
  movements   Movement[]
  loans       Loan[]

  @@map("departments")
}

model Subarea {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  users User[]
  loans Loan[]

  @@unique([departmentId, name])
  @@map("subareas")
}

model User {
  id             String  @id @default(uuid())
  username       String  @unique
  email          String? @unique
  password       String
  name           String
  role           Role    @default(EMPLOYEE)
  active         Boolean @default(true)
  jobTitle       String?
  employeeNumber String? @unique
  company        String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])

  // Personal / Recursos Humanos (expediente extendido, opcional)
  middleName      String?
  paternalSurname String?
  maternalSurname String?
  photoKey        String?

  genderId          String?
  gender            Gender?    @relation(fields: [genderId], references: [id], onDelete: SetNull)
  bloodTypeId       String?
  bloodType         BloodType? @relation(fields: [bloodTypeId], references: [id], onDelete: SetNull)
  medicalConditions String?
  allergies         String?

  birthDate DateTime? @db.Date
  hireDate  DateTime? @db.Date

  rfc  String?
  curp String?
  nss  String?

  streetAddress String?
  neighborhood  String?
  postalCode    String?
  city          String?
  addressState  String?
  country       String? @default("México")

  personalPhone String?
  workPhone     String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  discounts         EmployeeDiscount[]
  documents         EmployeeDocument[] @relation("EmployeeDocuments")
  uploadedDocuments EmployeeDocument[] @relation("EmployeeDocumentsUploader")

  disciplinaryReports         DisciplinaryReport[] @relation("DisciplinaryReportEmployee")
  authoredDisciplinaryReports DisciplinaryReport[] @relation("DisciplinaryReportAuthor")

  // Baja lógica explícita (separada de `active`, que cubre soft-delete físico).
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivatedBy      User?     @relation("UserDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivationReason String?
  deactivatedByUsers User[]    @relation("UserDeactivator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTickets     Ticket[]                  @relation("TicketCreatedBy")
  assignedTickets    Ticket[]                  @relation("TicketAssignedTo")
  ticketAssignments  TicketAssignment[]
  assignmentComments TicketAssignmentComment[]
  ticketComments     TicketComment[]           @relation("TicketCommentAuthor")
  ticketHistory      TicketHistory[]           @relation("TicketHistoryAuthor")
  notifications      Notification[]
  attachments        TicketAttachment[]
  materialOutputs    MaterialOutput[]

  createdMovements   Movement[]   @relation("MovementCreatedBy")
  custodiedMovements Movement[]   @relation("MovementCustodian")
  custodiedLoans     Loan[]       @relation("LoanCustodian")
  custodiedReturns   LoanReturn[] @relation("LoanReturnCustodian")

  sysConfigUpdates SysConfig[] @relation("SysConfigUpdater")

  // Control de acceso: el empleado es el sujeto del evento; el guardia, quien
  // lo registra. Relaciones con nombre para distinguir ambos roles.
  accessEventsAsEmployee AccessEvent[] @relation("AccessEventEmployee")
  accessEventsAsGuard    AccessEvent[] @relation("AccessEventGuard")

  scheduleAssignments        ScheduleAssignment[] @relation("ScheduleAssignee")
  createdScheduleAssignments ScheduleAssignment[] @relation("ScheduleAssignmentCreator")

  // Reloj checador: números del reloj vinculados a la persona y los vínculos
  // que capturó (relaciones con nombre para distinguir ambos roles).
  timeClockEmployees    TimeClockEmployee[] @relation("TimeClockEmployeeUser")
  createdTimeClockLinks TimeClockEmployee[] @relation("TimeClockEmployeeLinker")

  // Tiempo extra: decisiones de aprobación por persona y día, y las que capturó.
  overtimeApprovals OvertimeApproval[] @relation("OvertimeApprovalUser")
  overtimeDecisions OvertimeApproval[] @relation("OvertimeApprovalDecider")

  @@index([deactivatedAt])
  @@map("users")
}

model Gender {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("genders")
}

model BloodType {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("blood_types")
}

model DocumentType {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[]

  @@map("document_types")
}

model EmployeeDiscount {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DiscountType
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, type])
  @@map("employee_discounts")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  storageKey     String       @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  uploadedBy     User         @relation("EmployeeDocumentsUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([documentTypeId])
  @@map("employee_documents")
}

model DeviceType {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  assetTagPrefix  String   @unique
  counter         Int      @default(0)
  active          Boolean  @default(true)
  useSerialNumber Boolean  @default(true)
  useMac          Boolean  @default(false)
  useIp           Boolean  @default(false)
  useHostname     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  devices Device[]

  @@map("device_types")
}

model Device {
  id          String     @id @default(uuid())
  typeId      String
  type        DeviceType @relation(fields: [typeId], references: [id])
  name        String
  brand       String
  model       String
  description String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  units         DeviceUnit[]
  movementItems MovementItem[]
  loanItems     LoanItem[]
  returnItems   LoanReturnItem[]

  @@unique([typeId, name, brand, model])
  @@index([typeId])
  @@map("devices")
}

model DeviceUnit {
  id           String           @id @default(uuid())
  deviceId     String
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  assetTag     String           @unique
  serialNumber String?
  macAddress   String?          @unique
  ip           String?
  hostname     String?
  area         String           @default("SISTEMAS")
  status       DeviceUnitStatus @default(AVAILABLE)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  loanItemUnits     LoanItemUnit[]
  returnItemUnits   LoanReturnItemUnit[]
  materialOutputs   MaterialOutput[]
  movementItemUnits MovementItemUnit[]

  @@index([deviceId])
  @@index([status])
  @@index([departmentId])
  @@map("device_units")
}

model Movement {
  id           String         @id @default(uuid())
  type         MovementType
  date         DateTime       @default(now())
  createdById  String
  createdBy    User           @relation("MovementCreatedBy", fields: [createdById], references: [id])
  custodianId  String?
  custodian    User?          @relation("MovementCustodian", fields: [custodianId], references: [id])
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  reason       String?
  notes        String?
  status       MovementStatus @default(ACTIVE)
  reversalOfId String?        @unique
  reversalOf   Movement?      @relation("Reversal", fields: [reversalOfId], references: [id])
  reversals    Movement[]     @relation("Reversal")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items   MovementItem[]
  loan    Loan?
  returns LoanReturn[]

  @@index([date])
  @@index([type])
  @@index([status])
  @@map("movements")
}

model MovementItem {
  id         String         @id @default(uuid())
  movementId String
  movement   Movement       @relation(fields: [movementId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device         @relation(fields: [deviceId], references: [id])
  quantity   Int
  condition  ItemCondition?
  notes      String?

  units MovementItemUnit[]

  @@index([movementId])
  @@index([deviceId])
  @@map("movement_items")
}

model MovementItemUnit {
  id             String       @id @default(uuid())
  movementItemId String
  item           MovementItem @relation(fields: [movementItemId], references: [id], onDelete: Cascade)
  deviceUnitId   String
  deviceUnit     DeviceUnit   @relation(fields: [deviceUnitId], references: [id])

  @@unique([movementItemId, deviceUnitId])
  @@index([deviceUnitId])
  @@map("movement_item_units")
}

model Loan {
  id           String      @id @default(uuid())
  custodianId  String?
  custodian    User?       @relation("LoanCustodian", fields: [custodianId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])
  date         DateTime    @default(now())
  status       LoanStatus  @default(ACTIVE)
  movementId   String?     @unique
  movement     Movement?   @relation(fields: [movementId], references: [id])
  number       String      @unique
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items   LoanItem[]
  returns LoanReturn[]

  @@index([custodianId])
  @@index([status])
  @@map("loans")
}

model LoanItem {
  id               String  @id @default(uuid())
  loanId           String
  loan             Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  deviceId         String
  device           Device  @relation(fields: [deviceId], references: [id])
  quantity         Int
  returnedQuantity Int     @default(0)
  notes            String?

  units       LoanItemUnit[]
  returnItems LoanReturnItem[]

  @@index([loanId])
  @@index([deviceId])
  @@map("loan_items")
}

model LoanItemUnit {
  id           String     @id @default(uuid())
  loanItemId   String
  loanItem     LoanItem   @relation(fields: [loanItemId], references: [id], onDelete: Cascade)
  deviceUnitId String
  deviceUnit   DeviceUnit @relation(fields: [deviceUnitId], references: [id])
  returned     Boolean    @default(false)

  @@unique([loanItemId, deviceUnitId])
  @@index([deviceUnitId])
  @@map("loan_item_units")
}

model LoanReturn {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id])
  movementId  String   @unique
  movement    Movement @relation(fields: [movementId], references: [id])
  date        DateTime @default(now())
  custodianId String?
  custodian   User?    @relation("LoanReturnCustodian", fields: [custodianId], references: [id])
  number      String   @unique
  notes       String?

  items LoanReturnItem[]

  @@index([loanId])
  @@map("loan_returns")
}

model LoanReturnItem {
  id           String        @id @default(uuid())
  loanReturnId String
  loanReturn   LoanReturn    @relation(fields: [loanReturnId], references: [id], onDelete: Cascade)
  loanItemId   String
  loanItem     LoanItem      @relation(fields: [loanItemId], references: [id])
  deviceId     String
  device       Device        @relation(fields: [deviceId], references: [id])
  quantity     Int
  condition    ItemCondition
  notes        String?

  units LoanReturnItemUnit[]

  @@index([loanReturnId])
  @@index([loanItemId])
  @@map("loan_return_items")
}

model LoanReturnItemUnit {
  id               String         @id @default(uuid())
  loanReturnItemId String
  loanReturnItem   LoanReturnItem @relation(fields: [loanReturnItemId], references: [id], onDelete: Cascade)
  deviceUnitId     String
  deviceUnit       DeviceUnit     @relation(fields: [deviceUnitId], references: [id])

  @@unique([loanReturnItemId, deviceUnitId])
  @@index([deviceUnitId])
  @@map("loan_return_item_units")
}

model MaterialOutput {
  id             String                @id @default(uuid())
  date           DateTime              @default(now())
  description    String
  model          String?
  brand          String?
  project        String?
  quantity       Int                   @default(1)
  departmentName String
  userName       String
  notes          String?
  area           String                @default("Sistemas")
  reason         MaterialOutputReason?

  deviceUnitId String?
  deviceUnit   DeviceUnit? @relation(fields: [deviceUnitId], references: [id])

  registeredById String?
  registeredBy   User?   @relation(fields: [registeredById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([departmentName])
  @@index([deviceUnitId])
  @@index([area])
  @@map("material_outputs")
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  closedAt DateTime?
  closedBy String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    TicketComment[]
  history     TicketHistory[]
  assignments TicketAssignment[]
  attachments TicketAttachment[]

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([categoryId])
  @@map("tickets")
}

// Catálogo de categorías de ticket (antes enum TicketCategory).
model TicketCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_categories")
}

model TicketAssignment {
  id          String           @id @default(uuid())
  ticketId    String
  ticket      Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  title       String
  description String
  startDate   DateTime?
  dueDate     DateTime?
  status      AssignmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  comments    TicketAssignmentComment[]
  attachments TicketAttachment[]

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_assignments")
}

model TicketAssignmentComment {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   TicketAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User             @relation(fields: [authorId], references: [id])
  text         String
  createdAt    DateTime         @default(now())

  @@index([assignmentId])
  @@map("ticket_assignment_comments")
}

model TicketAttachment {
  id           String            @id @default(uuid())
  ticketId     String?
  ticket       Ticket?           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   TicketAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageKey   String            @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  kind         String            @default("PHOTO")
  createdAt    DateTime          @default(now())

  @@index([ticketId])
  @@index([assignmentId])
  @@index([uploadedById])
  @@map("ticket_attachments")
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketCommentAuthor", fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketHistory {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  authorId  String?
  author    User?    @relation("TicketHistoryAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_history")
}

// Contador legado del sistema anterior (serie `F-MMTO-`). Solo lo usa el seed;
// ningún código lo lee en runtime.
model LegacySequence {
  id        String   @id @default("singleton")
  prefix    String   @default("F-MMTO-")
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("legacy_sequences")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  detail    String?
  ticketId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String
  entityId      String
  userId        String?
  userName      String?
  deviceId      String?
  deviceCode    String?
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DisciplinaryReport {
  id           String             @id @default(uuid())
  reason       DisciplinaryReason
  incidentDate DateTime           @db.Date
  description  String
  sanction     String?
  createdAt    DateTime           @default(now())

  userId      String
  user        User   @relation("DisciplinaryReportEmployee", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("DisciplinaryReportAuthor", fields: [createdById], references: [id])

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("disciplinary_reports")
}

// Configuración del sistema editable desde el panel de catálogos.
// Permite mover valores que antes vivían en `process.env` a una tabla
// gestionable por el ADMIN en tiempo de ejecución, con auditoría.
model SysConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SysConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt(sort: Desc)])
  @@map("sys_config")
}

// Estado de un registro de correo en la cola/bitácora de envíos.
enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Cola de correo + bitácora de envíos (outbox pattern). Cada trigger de
// notificación solo INSERTA una fila PENDING (sin SMTP en el request); un
// worker en background la drena con `sendEmail` y la marca SENT/FAILED.
// Las filas terminales no se borran: es el log de envíos consultable por
// el ADMIN. `attachments` guarda referencias S3 `[{storageKey, originalName,
// contentType}]`; el worker descarga el objeto al enviar.
model EmailLog {
  id            String         @id @default(cuid())
  to            String
  subject       String
  html          String
  attachments   Json? // [{storageKey, originalName, contentType}]
  action        String? // "user.deactivate", "ticket.comment", "document.uploaded", ...
  entityType    String?
  entityId      String?
  status        EmailLogStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt(sort: Desc)])
  @@map("email_logs")
}

// Catálogo de sitios/porterías. El "dónde" semántico del escaneo.
model Site {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?  @unique
  active       Boolean  @default(true)
  latitude     Float?
  longitude    Float?
  radiusMeters Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessEvents AccessEvent[]

  @@map("sites")
}

// Evento de control de acceso. Cada escaneo es una fila inmutable; la jornada
// (entrada + salida) se deriva por consulta, nunca se materializa. La anulación
// es lógica (`voidedAt`/`voidedById`/`voidReason`): jamás se hace DELETE.
model AccessEvent {
  id              String          @id @default(uuid())
  type            AccessEventType
  // Hora autoritativa del servidor. El `deviceTimestamp` es solo auditoría.
  occurredAt      DateTime        @default(now())
  deviceTimestamp DateTime?

  employeeId             String
  employee               User    @relation("AccessEventEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  employeeNameSnapshot   String?
  employeeNumberSnapshot String?

  guardId String?
  guard   User?   @relation("AccessEventGuard", fields: [guardId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  locationSource    AccessLocationSource
  method            AccessMethod

  credentialVersion  Int?
  scannedPayloadHash String?

  // Idempotencia generada en el dispositivo.
  clientEventId String? @unique
  deviceId      String?
  deviceCode    String?

  notes String?

  // Anulación lógica.
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())

  @@index([occurredAt])
  @@index([employeeId, occurredAt])
  @@index([siteId])
  @@index([guardId])
  @@index([type])
  @@map("access_events")
}

// ---------------------------------------------------------------------------
// Horarios (administración) y asignación de horarios al personal.
// ---------------------------------------------------------------------------

/// Catálogo de horarios. La rejilla por día permite horarios que cambian por
/// día de la semana. Las horas son "de pared" (HH:mm), no instantes.
model Schedule {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)

  // Reglas de horas extra (minutos).
  entryToleranceMin Int     @default(10)
  exitToleranceMin  Int     @default(10)
  mealBreakMin      Int     @default(0)
  // Mínimo de tiempo extra para que cuente (0 = sin mínimo).
  minOvertimeMin    Int     @default(60)
  // Si la salida cae al día siguiente (turno nocturno).
  crossesMidnight   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days        ScheduleDay[]
  assignments ScheduleAssignment[]

  @@map("schedules")
}

/// Rejilla del horario por día de la semana (1=Lunes … 7=Domingo).
model ScheduleDay {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weekday    Int // 1..7

  startTime      String?
  endTime        String?
  // Turno partido (p. ej. camaristas/restaurante): segundo tramo opcional.
  splitStartTime String?
  splitEndTime   String?
  restDay        Boolean @default(false)

  @@unique([scheduleId, weekday])
  @@map("schedule_days")
}

/// Vigencia de un horario para una persona. El vigente es el que cubre "hoy".
model ScheduleAssignment {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("ScheduleAssignee", fields: [userId], references: [id])
  scheduleId String
  schedule   Schedule  @relation(fields: [scheduleId], references: [id])
  validFrom  DateTime
  validTo    DateTime?
  createdAt  DateTime  @default(now())

  createdById String?
  createdBy   User?   @relation("ScheduleAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, validFrom, validTo])
  @@index([scheduleId])
  @@map("schedule_assignments")
}

// ---------------------------------------------------------------------------
// Checador (reloj Hikvision). Copia de SOLO LECTURA de los eventos del equipo:
// la API nunca escribe en el reloj, solo lee su bitácora por ISAPI.
// ---------------------------------------------------------------------------

/// Cómo se identificó el empleado en el reloj (derivado del `minor` ISAPI).
enum PunchMethod {
  FACE
  FINGERPRINT
  CARD
  OTHER
}

/// Checada de un empleado identificado por el reloj. Inmutable: se copia tal
/// cual del equipo y nunca se edita. `serialNo` es el consecutivo del evento en
/// el reloj; con la serie del equipo identifica la checada, lo que hace
/// idempotente la sincronización.
model TimeClockPunch {
  id             String      @id @default(uuid())
  clockSerial    String
  serialNo       Int
  // Número y nombre tal como están dados de alta en el reloj.
  employeeNumber String
  name           String
  method         PunchMethod
  // Código `minor` del evento ISAPI (75 rostro, 38 huella, 1 tarjeta, …).
  minor          Int
  // Instante de la checada según el reloj del equipo.
  occurredAt     DateTime
  createdAt      DateTime    @default(now())

  @@unique([clockSerial, serialNo])
  @@index([occurredAt])
  @@index([employeeNumber, occurredAt])
  @@map("time_clock_punches")
}

/// Un reloj checador, identificado por su número de serie: cómo conectarse
/// (`url`, se da de alta desde la web) y hasta dónde se ha leído.
///
/// Cursor: todo evento con consecutivo `<= lastSerialNo` ya se procesó. Solo
/// avanza con una ventana o una corrida completas; si una corrida se corta, la
/// siguiente repite desde aquí y los duplicados se descartan por el `@@unique`
/// de `time_clock_punches`.
///
/// Dar de baja solo borra la `url`: el cursor, el nombre y las checadas se
/// quedan, y si el reloj se vuelve a dar de alta sigue desde donde iba.
model TimeClock {
  serialNumber     String    @id
  /// Para reconocerlo en pantalla (p. ej. "Entrada de personal").
  name             String?
  /// `http(s)://host[:puerto]`; `null` = dado de baja (no se sincroniza).
  url              String?   @unique
  /// Si sus checadas arman las entradas/salidas (y las horas extra). Los
  /// relojes de puertas de oficina se checan varias veces por turno: sus
  /// checadas se guardan, pero no cuentan como entrada o salida.
  countsAttendance Boolean   @default(true)
  model            String?
  lastSerialNo     Int       @default(0)
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("time_clocks")
}

/// Vínculo entre un empleado del reloj (su número en el equipo) y un usuario
/// del sistema. Es explícito: el número del reloj NO se compara tal cual con
/// `User.employeeNumber`, porque el reloj antepone el área (070562 ↔ 562) y el
/// número de nómina se repite entre áreas (040001 y 110001). Un usuario puede
/// tener más de un número de reloj (p. ej. si lo dieron de alta dos veces).
model TimeClockEmployee {
  employeeNumber String   @id
  userId         String
  user           User     @relation("TimeClockEmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  linkedById     String?
  linkedBy       User?    @relation("TimeClockEmployeeLinker", fields: [linkedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("time_clock_employees")
}

// ---------------------------------------------------------------------------
// Tiempo extra: decisión de aprobación por persona y día. La ausencia de fila
// significa PENDIENTE; solo se guardan las decisiones (aprobado/rechazado) con
// el snapshot del cálculo vigente al momento de decidir.
// ---------------------------------------------------------------------------

enum OvertimeApprovalStatus {
  APPROVED
  REJECTED
}

model OvertimeApproval {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation("OvertimeApprovalUser", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime               @db.Date
  status       OvertimeApprovalStatus
  // Snapshot del cálculo al momento de decidir (inmutable).
  extraMin     Int
  scheduleName String?
  scheduledMin Int?
  note         String?
  decidedById  String?
  decidedBy    User?                  @relation("OvertimeApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@map("overtime_approvals")
}

// ---------------------------------------------------------------------------
// Permisos: tanto el catálogo como la matriz rol → permiso → alcance viven en
// la base. El catálogo (`permissions`) es la fuente única de verdad de las
// claves; `role_permissions` las referencia por FK.
// ---------------------------------------------------------------------------

enum PermissionScope {
  NONE
  OWN
  AREA
  ALL
}

/// Catálogo de permisos (clave `module.action`). Fuente única de verdad en BD.
model Permission {
  key         String            @id
  module      String
  name        String
  description String?
  scopes      PermissionScope[]
  sensitive   Boolean           @default(false)
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  roles       RolePermission[]

  @@index([module, sortOrder])
  @@map("permissions")
}

/// Matriz rol → permiso → alcance. La ausencia de fila equivale a NONE; una
/// fila con NONE quita el permiso del rol de forma explícita (y evita que el
/// backfill del arranque lo reintroduzca). `permission` referencia el catálogo
/// en base (`permissions.key`) por FK con borrado/actualización en cascada.
model RolePermission {
  id         String          @id @default(uuid())
  role       Role
  permission String
  scope      PermissionScope
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  permissionRef Permission @relation(fields: [permission], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([role, permission])
  @@map("role_permissions")
}
