generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  JEFE_DE_AREA
  EMPLEADO
  RECURSOS_HUMANOS
  GUARD
}

enum TipoDescuento {
  INFONAVIT
  IMSS
  DEUDOR_ALIMENTICIO
}

enum MotivoActaAdministrativa {
  INASISTENCIA
  RETARDO
  EBRIEDAD
  CONDUCTA
  INCUMPLIMIENTO
  OTRO
}

enum MaterialOutputMotivo {
  DANADO
  OBSOLETO
  EXTRAVIO
  OTRO
}

// Estado de una unidad física de inventario.
enum EstadoInventario {
  DISPONIBLE
  PRESTADO
  DANADO
  MANTENIMIENTO
  BAJA
}

// Tipos de movimiento de inventario (cabecera + detalles).
enum TipoMovimiento {
  ENTRADA
  PRESTAMO
  DEVOLUCION
  BAJA
  TRASPASO
  AJUSTE_ENTRADA
  AJUSTE_SALIDA
  MANTENIMIENTO_ENTRADA
  MANTENIMIENTO_SALIDA
  REVERSION
}

enum EstadoMovimiento {
  ACTIVO
  CANCELADO
}

enum EstadoPrestamo {
  ACTIVO
  PARCIAL
  DEVUELTO
  CANCELADO
}

enum CondicionEnum {
  BUENO
  ACEPTABLE
  MALO
  ROTO
}

enum TicketStatus {
  ABIERTO
  EN_SEGUIMIENTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TicketCategory {
  MANTENIMIENTO
  EQUIPO
  SISTEMA
  OTRO
}

enum AssignmentStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADA
}

// Control de acceso (entradas/salidas de personal con credencial).
enum AccessEventType {
  ENTRY
  EXIT
}

// Cómo se obtuvo el "dónde" del escaneo: GPS del dispositivo, solo el sitio
// del catálogo, o captura manual (reservado, no usado en MVP).
enum AccessLocationSource {
  GPS
  SITE_ONLY
  MANUAL
}

// Medio por el que se registró el evento.
enum AccessMethod {
  QR_SCAN
  MANUAL
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subareas        Subarea[]
  users           User[]
  tickets         Ticket[]
  unidadesFisicas UnidadFisica[]
  movimientos     Movimiento[]
  prestamos       Prestamo[]

  @@map("departments")
}

model Subarea {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  users     User[]
  prestamos Prestamo[]

  @@unique([departmentId, name])
  @@map("subareas")
}

model User {
  id             String  @id @default(uuid())
  username       String  @unique
  email          String? @unique
  password       String
  name           String
  role           Role    @default(EMPLEADO)
  active         Boolean @default(true)
  puesto         String?
  numeroEmpleado String? @unique
  empresa        String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])

  // Personal / Recursos Humanos (expediente extendido, opcional)
  segundoNombre   String?
  apellidoPaterno String?
  apellidoMaterno String?
  fotoKey         String?

  generoId     String?
  genero       Genero?     @relation(fields: [generoId], references: [id], onDelete: SetNull)
  tipoSangreId String?
  tipoSangre   TipoSangre? @relation(fields: [tipoSangreId], references: [id], onDelete: SetNull)
  padecimiento String?
  alergias     String?

  fechaNacimiento DateTime? @db.Date
  fechaIngreso    DateTime? @db.Date

  rfc  String?
  curp String?
  nss  String?

  calleNumero     String?
  colonia         String?
  codigoPostal    String?
  ciudad          String?
  estadoDireccion String?
  pais            String? @default("México")

  celularPersonal String?
  celularEmpresa  String?

  contactoEmergenciaNombre     String?
  contactoEmergenciaTelefono   String?
  contactoEmergenciaParentesco String?

  discounts         EmployeeDiscount[]
  documentos        EmployeeDocument[] @relation("EmployeeDocuments")
  documentosSubidos EmployeeDocument[] @relation("EmployeeDocumentsUploader")

  actasAdministrativas    CartaAdministrativa[] @relation("ActaAdministrativaEmpleado")
  actasAdministrativasCre CartaAdministrativa[] @relation("ActaAdministrativaAutor")

  // Baja lógica explícita (separada de `active`, que cubre soft-delete físico).
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivatedBy      User?     @relation("UserDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivationReason String?
  deactivatedByUsers User[]    @relation("UserDeactivator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketsCreados     Ticket[]                  @relation("TicketCreadoPor")
  ticketsAsignados   Ticket[]                  @relation("TicketAsignadoA")
  ticketAssignments  TicketAssignment[]
  assignmentComments TicketAssignmentComment[]
  ticketComments     TicketComment[]           @relation("TicketCommentAutor")
  ticketHistory      TicketHistory[]           @relation("TicketHistoryAutor")
  notifications      Notification[]
  attachments        TicketAttachment[]
  materialOutputs    MaterialOutput[]

  movimientosCreados      Movimiento[] @relation("MovimientoUsuario")
  movimientosResponsable  Movimiento[] @relation("MovimientoResponsable")
  prestamosResponsable    Prestamo[]   @relation("PrestamoResponsable")
  devolucionesResponsable Devolucion[] @relation("DevolucionResponsable")

  sysConfigUpdates SysConfig[] @relation("SysConfigUpdater")

  // Control de acceso: el empleado es el sujeto del evento; el guardia, quien
  // lo registra. Relaciones con nombre para distinguir ambos roles.
  accessEventsAsEmployee AccessEvent[] @relation("AccessEventEmployee")
  accessEventsAsGuard    AccessEvent[] @relation("AccessEventGuard")

  @@index([deactivatedAt])
  @@map("users")
}

model Genero {
  id        String   @id @default(uuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios User[]

  @@map("generos")
}

model TipoSangre {
  id        String   @id @default(uuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  usuarios User[]

  @@map("tipos_sangre")
}

model TipoDocumento {
  id        String   @id @default(uuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentos EmployeeDocument[]

  @@map("tipos_documento")
}

model EmployeeDiscount {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      TipoDescuento
  nota      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, tipo])
  @@map("employee_discounts")
}

model EmployeeDocument {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  tipoDocumentoId String
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id])
  storageKey      String        @unique
  originalName    String
  mimeType        String
  sizeBytes       Int
  uploadedById    String
  uploadedBy      User          @relation("EmployeeDocumentsUploader", fields: [uploadedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([tipoDocumentoId])
  @@map("employee_documents")
}

model TipoDispositivo {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  folioPrefix String   @unique
  contador    Int      @default(0)
  active      Boolean  @default(true)
  useSerie    Boolean  @default(true)
  useMac      Boolean  @default(false)
  useIp       Boolean  @default(false)
  useEquipo   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dispositivos Dispositivo[]

  @@map("tipos_dispositivo")
}

model Dispositivo {
  id            String          @id @default(uuid())
  tipoId        String
  tipo          TipoDispositivo @relation(fields: [tipoId], references: [id])
  nombre        String
  marca         String
  modelo        String
  descripcion   String?
  observaciones String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  unidades           UnidadFisica[]
  movimientoDetalles MovimientoDetalle[]
  prestamoDetalles   PrestamoDetalle[]
  devolucionDetalles DevolucionDetalle[]

  @@unique([tipoId, nombre, marca, modelo])
  @@index([tipoId])
  @@map("dispositivos")
}

model UnidadFisica {
  id             String           @id @default(uuid())
  dispositivoId  String
  dispositivo    Dispositivo      @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  activoFijo     String           @unique
  numeroSerie    String?
  macAddress     String?          @unique
  ip             String?
  nombreEquipo   String?
  area           String           @default("SISTEMAS")
  estado         EstadoInventario @default(DISPONIBLE)
  departamentoId String?
  departamento   Department?      @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  prestamoDetalleUnidades   PrestamoDetalleUnidad[]
  devolucionDetalleUnidades DevolucionDetalleUnidad[]
  materialOutputs           MaterialOutput[]
  movimientoDetalleUnidades MovimientoDetalleUnidad[]

  @@index([dispositivoId])
  @@index([estado])
  @@index([departamentoId])
  @@map("unidades_fisicas")
}

model Movimiento {
  id             String           @id @default(uuid())
  tipo           TipoMovimiento
  fecha          DateTime         @default(now())
  usuarioId      String
  usuario        User             @relation("MovimientoUsuario", fields: [usuarioId], references: [id])
  responsableId  String?
  responsable    User?            @relation("MovimientoResponsable", fields: [responsableId], references: [id])
  departamentoId String?
  departamento   Department?      @relation(fields: [departamentoId], references: [id])
  motivo         String?
  observaciones  String?
  status         EstadoMovimiento @default(ACTIVO)
  reversaDeId    String?          @unique
  reversaDe      Movimiento?      @relation("Reversion", fields: [reversaDeId], references: [id])
  reversiones    Movimiento[]     @relation("Reversion")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  detalles     MovimientoDetalle[]
  prestamo     Prestamo?
  devoluciones Devolucion[]

  @@index([fecha])
  @@index([tipo])
  @@index([status])
  @@map("movimientos")
}

model MovimientoDetalle {
  id            String         @id @default(uuid())
  movimientoId  String
  movimiento    Movimiento     @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  dispositivoId String
  dispositivo   Dispositivo    @relation(fields: [dispositivoId], references: [id])
  cantidad      Int
  condicion     CondicionEnum?
  observaciones String?

  unidades MovimientoDetalleUnidad[]

  @@index([movimientoId])
  @@index([dispositivoId])
  @@map("movimiento_detalles")
}

model MovimientoDetalleUnidad {
  id                  String            @id @default(uuid())
  movimientoDetalleId String
  detalle             MovimientoDetalle @relation(fields: [movimientoDetalleId], references: [id], onDelete: Cascade)
  unidadFisicaId      String
  unidadFisica        UnidadFisica      @relation(fields: [unidadFisicaId], references: [id])

  @@unique([movimientoDetalleId, unidadFisicaId])
  @@index([unidadFisicaId])
  @@map("movimiento_detalle_unidades")
}

model Prestamo {
  id             String         @id @default(uuid())
  responsableId  String?
  responsable    User?          @relation("PrestamoResponsable", fields: [responsableId], references: [id])
  departamentoId String?
  departamento   Department?    @relation(fields: [departamentoId], references: [id])
  subareaId      String?
  subarea        Subarea?       @relation(fields: [subareaId], references: [id])
  fecha          DateTime       @default(now())
  status         EstadoPrestamo @default(ACTIVO)
  movimientoId   String?        @unique
  movimiento     Movimiento?    @relation(fields: [movimientoId], references: [id])
  consecutivo    String         @unique
  observaciones  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  detalles     PrestamoDetalle[]
  devoluciones Devolucion[]

  @@index([responsableId])
  @@index([status])
  @@map("prestamos")
}

model PrestamoDetalle {
  id            String      @id @default(uuid())
  prestamoId    String
  prestamo      Prestamo    @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id])
  cantidad      Int
  devuelto      Int         @default(0)
  observaciones String?

  unidades           PrestamoDetalleUnidad[]
  devolucionDetalles DevolucionDetalle[]

  @@index([prestamoId])
  @@index([dispositivoId])
  @@map("prestamo_detalles")
}

model PrestamoDetalleUnidad {
  id                String          @id @default(uuid())
  prestamoDetalleId String
  prestamoDetalle   PrestamoDetalle @relation(fields: [prestamoDetalleId], references: [id], onDelete: Cascade)
  unidadFisicaId    String
  unidadFisica      UnidadFisica    @relation(fields: [unidadFisicaId], references: [id])
  devuelto          Boolean         @default(false)

  @@unique([prestamoDetalleId, unidadFisicaId])
  @@index([unidadFisicaId])
  @@map("prestamo_detalle_unidades")
}

model Devolucion {
  id            String     @id @default(uuid())
  prestamoId    String
  prestamo      Prestamo   @relation(fields: [prestamoId], references: [id])
  movimientoId  String     @unique
  movimiento    Movimiento @relation(fields: [movimientoId], references: [id])
  fecha         DateTime   @default(now())
  responsableId String?
  responsable   User?      @relation("DevolucionResponsable", fields: [responsableId], references: [id])
  consecutivo   String     @unique
  observaciones String?

  detalles DevolucionDetalle[]

  @@index([prestamoId])
  @@map("devoluciones")
}

model DevolucionDetalle {
  id                String          @id @default(uuid())
  devolucionId      String
  devolucion        Devolucion      @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  prestamoDetalleId String
  prestamoDetalle   PrestamoDetalle @relation(fields: [prestamoDetalleId], references: [id])
  dispositivoId     String
  dispositivo       Dispositivo     @relation(fields: [dispositivoId], references: [id])
  cantidad          Int
  condicion         CondicionEnum
  observaciones     String?

  unidades DevolucionDetalleUnidad[]

  @@index([devolucionId])
  @@index([prestamoDetalleId])
  @@map("devolucion_detalles")
}

model DevolucionDetalleUnidad {
  id                  String            @id @default(uuid())
  devolucionDetalleId String
  devolucionDetalle   DevolucionDetalle @relation(fields: [devolucionDetalleId], references: [id], onDelete: Cascade)
  unidadFisicaId      String
  unidadFisica        UnidadFisica      @relation(fields: [unidadFisicaId], references: [id])

  @@unique([devolucionDetalleId, unidadFisicaId])
  @@index([unidadFisicaId])
  @@map("devolucion_detalle_unidades")
}

model MaterialOutput {
  id            String                @id @default(uuid())
  fecha         DateTime              @default(now())
  descripcion   String
  modelo        String?
  marca         String?
  proyecto      String?
  cantidad      Int                   @default(1)
  departamento  String
  usuario       String
  observaciones String?
  area          String                @default("Sistemas")
  motivo        MaterialOutputMotivo?

  unidadFisicaId String?
  unidadFisica   UnidadFisica? @relation(fields: [unidadFisicaId], references: [id])

  registradoPorId String?
  registradoPor   User?   @relation(fields: [registradoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([departamento])
  @@index([unidadFisicaId])
  @@index([area])
  @@map("material_outputs")
}

model Ticket {
  id          String         @id @default(uuid())
  titulo      String
  descripcion String
  status      TicketStatus   @default(ABIERTO)
  priority    TicketPriority @default(MEDIA)
  category    TicketCategory @default(OTRO)

  creadoPorId String
  creadoPor   User   @relation("TicketCreadoPor", fields: [creadoPorId], references: [id])

  asignadoAId String?
  asignadoA   User?   @relation("TicketAsignadoA", fields: [asignadoAId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  closedAt DateTime?
  closedBy String?

  deletedAt DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  comments    TicketComment[]
  history     TicketHistory[]
  assignments TicketAssignment[]
  attachments TicketAttachment[]

  @@index([status])
  @@index([creadoPorId])
  @@index([asignadoAId])
  @@map("tickets")
}

model TicketAssignment {
  id          String           @id @default(uuid())
  ticketId    String
  ticket      Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  title       String
  description String
  startDate   DateTime?
  dueDate     DateTime?
  status      AssignmentStatus @default(PENDIENTE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  comments    TicketAssignmentComment[]
  attachments TicketAttachment[]

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_assignments")
}

model TicketAssignmentComment {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   TicketAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  autorId      String
  autor        User             @relation(fields: [autorId], references: [id])
  texto        String
  createdAt    DateTime         @default(now())

  @@index([assignmentId])
  @@map("ticket_assignment_comments")
}

model TicketAttachment {
  id           String            @id @default(uuid())
  ticketId     String?
  ticket       Ticket?           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   TicketAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageKey   String            @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  kind         String            @default("FOTO")
  createdAt    DateTime          @default(now())

  @@index([ticketId])
  @@index([assignmentId])
  @@index([uploadedById])
  @@map("ticket_attachments")
}

model TicketComment {
  id       String   @id @default(uuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autorId  String
  autor    User     @relation("TicketCommentAutor", fields: [autorId], references: [id])
  texto    String
  creadoEn DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketHistory {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  autorId   String?
  autor     User?    @relation("TicketHistoryAutor", fields: [autorId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_history")
}

model Consecutivo {
  id            String   @id @default("singleton")
  prefijo       String   @default("F-MMTO-")
  contador      Int      @default(0)
  actualizadoEn DateTime @updatedAt

  @@map("consecutivos")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  detail    String?
  ticketId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String
  entityId      String
  userId        String?
  userName      String?
  deviceId      String?
  deviceCode    String?
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CartaAdministrativa {
  id             String                   @id @default(uuid())
  motivo         MotivoActaAdministrativa
  fechaIncidente DateTime                 @db.Date
  descripcion    String
  sancion        String?
  createdAt      DateTime                 @default(now())

  userId      String
  user        User   @relation("ActaAdministrativaEmpleado", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("ActaAdministrativaAutor", fields: [createdById], references: [id])

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("cartas_administrativas")
}

// Configuración del sistema editable desde el panel de catálogos.
// Permite mover valores que antes vivían en `process.env` a una tabla
// gestionable por el ADMIN en tiempo de ejecución, con auditoría.
model SysConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  descripcion String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SysConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt(sort: Desc)])
  @@map("sys_config")
}

// Catálogo de sitios/porterías. El "dónde" semántico del escaneo.
model Site {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?  @unique
  active       Boolean  @default(true)
  latitude     Float?
  longitude    Float?
  radiusMeters Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessEvents AccessEvent[]

  @@map("sites")
}

// Evento de control de acceso. Cada escaneo es una fila inmutable; la jornada
// (entrada + salida) se deriva por consulta, nunca se materializa. La anulación
// es lógica (`voidedAt`/`voidedById`/`voidReason`): jamás se hace DELETE.
model AccessEvent {
  id          String          @id @default(uuid())
  type        AccessEventType
  // Hora autoritativa del servidor. El `deviceTimestamp` es solo auditoría.
  occurredAt  DateTime        @default(now())
  deviceTimestamp DateTime?

  employeeId             String
  employee               User    @relation("AccessEventEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  employeeNameSnapshot   String?
  employeeNumberSnapshot String?

  guardId String?
  guard   User?   @relation("AccessEventGuard", fields: [guardId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  locationSource    AccessLocationSource
  method            AccessMethod

  credentialVersion  Int?
  scannedPayloadHash String?

  // Idempotencia generada en el dispositivo.
  clientEventId String? @unique
  deviceId      String?
  deviceCode    String?

  notes String?

  // Anulación lógica.
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())

  @@index([occurredAt])
  @@index([employeeId, occurredAt])
  @@index([siteId])
  @@index([guardId])
  @@index([type])
  @@map("access_events")
}
