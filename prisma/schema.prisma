generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  JEFE_DE_AREA
  EMPLEADO
}

enum DeviceEstado {
  DISPONIBLE
  ASIGNADO
  BAJA
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subareas Subarea[]
  users    User[]
  tickets  Ticket[]

  @@map("departments")
}

model Subarea {
  id           String  @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  users User[]

  @@unique([departmentId, name])
  @@map("subareas")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(EMPLEADO)
  active    Boolean  @default(true)
  puesto    String?
  numeroEmpleado String? @unique

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartasCreadas     CartaResponsiva[] @relation("CartaCreadoPor")
  cartasResponsable CartaResponsiva[] @relation("CartaResponsable")
  cartasEncargado   CartaResponsiva[] @relation("CartaEncargado")
  ticketsCreados    Ticket[]          @relation("TicketCreadoPor")
  ticketsAsignados  Ticket[]          @relation("TicketAsignadoA")
  ticketComments    TicketComment[]   @relation("TicketCommentAutor")
  ticketHistory     TicketHistory[]   @relation("TicketHistoryAutor")
  deviceHistory     DeviceHistory[]
  notifications     Notification[]

  @@map("users")
}

model DeviceType {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  prefix        String   @unique
  contador      Int      @default(0)
  cartaContador Int      @default(0)
  active        Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@map("device_types")
}

model Device {
  id             String       @id @default(uuid())
  typeId         String
  type           DeviceType   @relation(fields: [typeId], references: [id])
  controlActivos String       @unique
  descripcion    String
  marca          String
  modelo         String
  numeroSerie    String?
  nombreEquipo   String?
  area           String       @default("MANTENIMIENTO")
  estado         DeviceEstado @default(DISPONIBLE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cartaItems CartaItem[]
  history    DeviceHistory[]

  @@index([typeId])
  @@index([estado])
  @@map("devices")
}

model DeviceHistory {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      String   // CREATED, ASSIGNED, RETURNED, RETIRED, UPDATED, COMMENT
  detail    String?
  autorId   String?
  autor     User?    @relation(fields: [autorId], references: [id])
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@map("device_history")
}

model CartaResponsiva {
  id              String   @id @default(uuid())
  consecutivo     String   @unique
  fecha           DateTime @default(now())
  numeroEmpleado  String
  empresa         String   @default("Puerto Nuevo Hotel y Villas")
  departamento    String   @default("Departamento de Mantenimiento")

  creadoPorId String?
  creadoPor   User?  @relation("CartaCreadoPor", fields: [creadoPorId], references: [id])
  responsableId String?
  responsable User?  @relation("CartaResponsable", fields: [responsableId], references: [id])
  encargadoId String?
  encargado   User?  @relation("CartaEncargado", fields: [encargadoId], references: [id])

  areaBoss   String?  // jefe de área (texto libre)
  deliveryBy String   @default("Departamento de Mantenimiento") // firma "Entrega"

  returnDate      DateTime?
  returnedBy      String?
  returnCondition String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  items CartaItem[]

  @@index([consecutivo])
  @@index([fecha])
  @@index([creadoPorId])
  @@index([responsableId])
  @@index([encargadoId])
  @@map("cartas_responsivas")
}

model CartaItem {
  id             String          @id @default(uuid())
  cartaId        String
  carta          CartaResponsiva @relation(fields: [cartaId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?         @relation(fields: [deviceId], references: [id])

  descripcion    String
  marca          String
  modelo         String
  numeroSerie    String @default("N/A")
  nombreEquipo   String @default("N/A")
  controlActivos String
  area           String @default("MANTENIMIENTO")

  @@index([cartaId])
  @@index([deviceId])
  @@map("carta_items")
}

enum TicketStatus {
  ABIERTO
  EN_SEGUIMIENTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TicketCategory {
  MANTENIMIENTO
  EQUIPO
  SISTEMA
  OTRO
}

model Ticket {
  id              String         @id @default(uuid())
  titulo          String
  descripcion     String
  status          TicketStatus   @default(ABIERTO)
  priority        TicketPriority @default(MEDIA)
  category        TicketCategory @default(OTRO)

  creadoPorId     String
  creadoPor       User           @relation("TicketCreadoPor", fields: [creadoPorId], references: [id])

  asignadoAId     String?
  asignadoA       User?          @relation("TicketAsignadoA", fields: [asignadoAId], references: [id])

  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])

  closedAt        DateTime?
  closedBy        String?

  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  comments        TicketComment[]
  history         TicketHistory[]

  @@index([status])
  @@index([creadoPorId])
  @@index([asignadoAId])
  @@map("tickets")
}

model TicketComment {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User     @relation("TicketCommentAutor", fields: [autorId], references: [id])
  texto       String
  creadoEn    DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketHistory {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type        String
  detail      String?
  autorId     String?
  autor       User?    @relation("TicketHistoryAutor", fields: [autorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_history")
}

model Consecutivo {
  id            String   @id @default("singleton")
  prefijo       String   @default("F-MMTO-")
  contador      Int      @default(0)
  actualizadoEn DateTime @updatedAt

  @@map("consecutivos")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // COMMENT, TICKET_ASSIGNED, TICKET_UPDATED, TICKET_CREATED
  title     String
  detail    String?
  ticketId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}