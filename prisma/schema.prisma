generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  JEFE_DE_AREA
  EMPLEADO
}

enum DeviceEstado {
  DISPONIBLE
  ASIGNADO
  BAJA
}

enum MovementType {
  ENTRADA
  SALIDA
  TRASLADO
  BAJA
  PRESTAMO
  DEVOLUCION
}

enum CondicionEnum {
  BUENO
  ACEPTABLE
  MALO
  ROTO
}

enum TicketStatus {
  ABIERTO
  EN_SEGUIMIENTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TicketCategory {
  MANTENIMIENTO
  EQUIPO
  SISTEMA
  OTRO
}

enum AssignmentStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADA
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subareas Subarea[]
  users    User[]
  tickets  Ticket[]

  @@map("departments")
}

model Subarea {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  users User[]

  @@unique([departmentId, name])
  @@map("subareas")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String
  name      String
  role      Role     @default(EMPLEADO)
  active    Boolean  @default(true)
  puesto    String?
  numeroEmpleado String? @unique
  empresa   String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartasCreadas       CartaResponsiva[]  @relation("CartaCreadoPor")
  cartasResponsable   CartaResponsiva[]  @relation("CartaResponsable")
  cartasEncargado     CartaResponsiva[]  @relation("CartaEncargado")
  ticketsCreados      Ticket[]           @relation("TicketCreadoPor")
  ticketsAsignados    Ticket[]           @relation("TicketAsignadoA")
  ticketAssignments   TicketAssignment[]
  assignmentComments  TicketAssignmentComment[]
  ticketComments      TicketComment[]    @relation("TicketCommentAutor")
  ticketHistory       TicketHistory[]    @relation("TicketHistoryAutor")
  deviceHistory       DeviceHistory[]
  notifications       Notification[]
  attachments         TicketAttachment[]
  inventoryMovements  InventoryMovement[]
  materialOutputs     MaterialOutput[]

  @@map("users")
}

model DeviceType {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  prefix        String   @unique
  contador      Int      @default(0)
  cartaContador Int      @default(0)
  active        Boolean  @default(true)
  fieldConfig   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@map("device_types")
}

model Device {
  id             String       @id @default(uuid())
  typeId         String
  type           DeviceType   @relation(fields: [typeId], references: [id])
  controlActivos String       @unique
  descripcion    String
  marca          String
  modelo         String
  numeroSerie    String?
  nombreEquipo   String?
  area           String       @default("SISTEMAS")
  estado         DeviceEstado @default(DISPONIBLE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Especificaciones técnicas (TIC) — solo aplica a PC / TABLET / LAPTOP
  ip              String?
  macAddress      String?  @map("mac_address")
  sistemaOp       String?  @map("sistema_op")
  ram             String?
  almacenamiento  String?

  // Agrupa unidades dadas de alta juntas en un mismo lote (alta por cantidad),
  // para poder editar los datos compartidos de todas a la vez.
  loteId          String?

  locationId      String?
  location        Location?  @relation(fields: [locationId], references: [id])

  cartaItems          CartaItem[]
  history             DeviceHistory[]
  movements           InventoryMovement[]
  materialOutputs     MaterialOutput[]

  @@index([typeId])
  @@index([estado])
  @@index([locationId])
  @@index([macAddress])
  @@index([loteId])
  @@map("devices")
}

model Location {
  id          String   @id @default(uuid())
  lugar       String?
  subLugar    String?
  numero      String?
  descripcion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices   Device[]
  movements InventoryMovement[]

  @@map("locations")
}

model InventoryMovement {
  id          String       @id @default(uuid())
  deviceId    String
  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location?    @relation(fields: [locationId], references: [id])
  tipo        MovementType
  notas       String?
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())
  prestamoId  String?
  prestamo    InventoryMovement?  @relation("PrestamoDevolucion", fields: [prestamoId], references: [id])
  devolucion  InventoryMovement[] @relation("PrestamoDevolucion")
  prestadoA   String?
  fechaRetornoEsperado DateTime?
  condicion   CondicionEnum?
  motivoBaja  String?

  @@index([deviceId])
  @@index([locationId])
  @@index([userId])
  @@index([createdAt])
  @@index([prestamoId])
  @@map("inventory_movements")
}

model DeviceHistory {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      String   // CREATED, ASSIGNED, RETURNED, RETIRED, UPDATED, COMMENT
  detail    String?
  autorId   String?
  autor     User?    @relation(fields: [autorId], references: [id])
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@map("device_history")
}

model MaterialOutput {
  id             String   @id @default(uuid())
  fecha          DateTime @default(now())
  descripcion    String
  modelo         String?
  marca          String?
  proyecto       String?
  cantidad       Int      @default(1)
  departamento   String
  usuario        String
  observaciones  String?
  area           String   @default("Sistemas")

  deviceId       String?
  device         Device?  @relation(fields: [deviceId], references: [id])

  registradoPorId String?
  registradoPor   User?   @relation(fields: [registradoPorId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fecha])
  @@index([departamento])
  @@index([deviceId])
  @@index([area])
  @@map("material_outputs")
}

model CartaResponsiva {
  id              String   @id @default(uuid())
  consecutive     String   @unique
  fecha           DateTime @default(now())
  numeroEmpleado  String
  empresa         String   @default("Puerto Nuevo Hotel y Villas")
  departamento    String   @default("Departamento de Mantenimiento")

  creadoPorId String?
  creadoPor   User?  @relation("CartaCreadoPor", fields: [creadoPorId], references: [id])
  responsableId String?
  responsable User?  @relation("CartaResponsable", fields: [responsableId], references: [id])
  encargadoId String?
  encargado   User?  @relation("CartaEncargado", fields: [encargadoId], references: [id])

  areaBoss   String?  // jefe de área (texto libre)
  deliveryBy String   @default("Departamento de Mantenimiento") // firma "Entrega"

  returnDate      DateTime?
  returnedBy      String?
  returnCondition String?

  inventoryMovementId String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  items CartaItem[]

  @@index([consecutive])
  @@index([fecha])
  @@index([creadoPorId])
  @@index([responsableId])
  @@index([encargadoId])
  @@index([inventoryMovementId])
  @@map("cartas_responsivas")
}

model CartaItem {
  id             String          @id @default(uuid())
  cartaId        String
  carta          CartaResponsiva @relation(fields: [cartaId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?         @relation(fields: [deviceId], references: [id])

  descripcion    String
  marca          String
  modelo         String
  numeroSerie    String @default("N/A")
  nombreEquipo   String @default("N/A")
  controlActivos String
  area           String @default("MANTENIMIENTO")

  @@index([cartaId])
  @@index([deviceId])
  @@map("carta_items")
}

model Ticket {
  id              String         @id @default(uuid())
  titulo          String
  descripcion     String
  status          TicketStatus   @default(ABIERTO)
  priority        TicketPriority @default(MEDIA)
  category        TicketCategory @default(OTRO)

  creadoPorId     String
  creadoPor       User           @relation("TicketCreadoPor", fields: [creadoPorId], references: [id])

  asignadoAId     String?
  asignadoA       User?          @relation("TicketAsignadoA", fields: [asignadoAId], references: [id])

  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id])

  closedAt        DateTime?
  closedBy        String?

  // Soft delete: primera eliminación marca deletedAt (queda visible como
  // "eliminado"); una segunda eliminación borra físicamente.
  deletedAt       DateTime?

  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  comments        TicketComment[]
  history         TicketHistory[]
  assignments     TicketAssignment[]
  attachments     TicketAttachment[]

  @@index([status])
  @@index([creadoPorId])
  @@index([asignadoAId])
  @@map("tickets")
}

// Asignación de un empleado a un ticket con su tarea. Un ticket puede tener
// N asignaciones (grafo: cada empleado con su tarea y estado propio).
model TicketAssignment {
  id          String          @id @default(uuid())
  ticketId    String
  ticket      Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  title       String
  description String
  startDate   DateTime?
  dueDate     DateTime?
  status      AssignmentStatus @default(PENDIENTE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  comments TicketAssignmentComment[]
  attachments TicketAttachment[]

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_assignments")
}

model TicketAssignmentComment {
  id           String          @id @default(uuid())
  assignmentId String
  assignment   TicketAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  autorId      String
  autor        User            @relation(fields: [autorId], references: [id])
  texto        String
  createdAt    DateTime        @default(now())

  @@index([assignmentId])
  @@map("ticket_assignment_comments")
}

model TicketAttachment {
  id             String           @id @default(uuid())
  ticketId       String?
  ticket         Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     TicketAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageKey     String           @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  kind           String           @default("FOTO")
  createdAt      DateTime         @default(now())

  @@index([ticketId])
  @@index([assignmentId])
  @@index([uploadedById])
  @@map("ticket_attachments")
}

model TicketComment {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User     @relation("TicketCommentAutor", fields: [autorId], references: [id])
  texto       String
  creadoEn    DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketHistory {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type        String
  detail      String?
  autorId     String?
  autor       User?    @relation("TicketHistoryAutor", fields: [autorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_history")
}

model Consecutivo {
  id            String   @id @default("singleton")
  prefijo       String   @default("F-MMTO-")
  contador      Int      @default(0)
  actualizadoEn DateTime @updatedAt

  @@map("consecutivos")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // COMMENT, TICKET_ASSIGNED, TICKET_UPDATED, TICKET_CREATED
  title     String
  detail    String?
  ticketId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String   // MOVEMENT_ENTRADA, MOVEMENT_SALIDA, CARTA_CREATED, DEVICE_UPDATED, etc.
  entityType    String   // InventoryMovement, Device, CartaResponsiva, Ticket, etc.
  entityId      String
  userId        String?
  userName      String?
  deviceId      String?
  deviceCode    String?
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("audit_logs")
}

