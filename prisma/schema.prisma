generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  INFONAVIT
  IMSS
  CHILD_SUPPORT
}

enum DisciplinaryReason {
  ABSENCE
  TARDINESS
  INTOXICATION
  MISCONDUCT
  NONCOMPLIANCE
  OTHER
}

enum MaterialOutputReason {
  DAMAGED
  OBSOLETE
  LOST
  OTHER
}

// Estado de una unidad física de inventario.
enum DeviceUnitStatus {
  AVAILABLE
  ON_LOAN
  DAMAGED
  IN_MAINTENANCE
  RETIRED
}

// Tipos de movimiento de inventario (cabecera + detalles).
enum MovementType {
  STOCK_IN
  LOAN
  RETURN
  RETIREMENT
  TRANSFER
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  MAINTENANCE_IN
  MAINTENANCE_OUT
  REVERSAL
}

enum MovementStatus {
  ACTIVE
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  PARTIAL
  RETURNED
  CANCELLED
}

enum ItemCondition {
  GOOD
  FAIR
  POOR
  BROKEN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

// Control de acceso (entradas/salidas de personal con credencial).
enum AccessEventType {
  ENTRY
  EXIT
}

// Cómo se obtuvo el "dónde" del escaneo: GPS del dispositivo, solo el sitio
// del catálogo, o captura manual (reservado, no usado en MVP).
enum AccessLocationSource {
  GPS
  SITE_ONLY
  MANUAL
}

// Medio por el que se registró el evento.
enum AccessMethod {
  QR_SCAN
  MANUAL
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subareas    Subarea[]
  users       User[]
  tickets     Ticket[]
  deviceUnits DeviceUnit[]
  movements   Movement[]
  loans       Loan[]
  costCenters CostCenter[]

  @@map("departments")
}

model Subarea {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  users User[]
  loans Loan[]

  @@unique([departmentId, name])
  @@map("subareas")
}

model User {
  id             String  @id @default(uuid())
  username       String  @unique
  email          String? @unique
  password       String
  name           String
  role           String  @default("EMPLOYEE")
  roleRef        Role    @relation(fields: [role], references: [key])
  extraRoles     UserRole[]
  permissionGrants  UserPermission[] @relation("UserPermissionGrants")
  permissionsGranted UserPermission[] @relation("UserPermissionGrantedBy")
  policiesCreated    Policy[] @relation("PolicyCreatedBy")
  active         Boolean @default(true)
  jobTitle       String?
  employeeNumber String? @unique
  company        String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])

  // Personal / Recursos Humanos (expediente extendido, opcional)
  middleName      String?
  paternalSurname String?
  maternalSurname String?
  photoKey        String?

  genderId          String?
  gender            Gender?    @relation(fields: [genderId], references: [id], onDelete: SetNull)
  bloodTypeId       String?
  bloodType         BloodType? @relation(fields: [bloodTypeId], references: [id], onDelete: SetNull)
  medicalConditions String?
  allergies         String?

  birthDate DateTime? @db.Date
  hireDate  DateTime? @db.Date

  rfc  String?
  curp String?
  nss  String?

  streetAddress String?
  neighborhood  String?
  postalCode    String?
  city          String?
  addressState  String?
  country       String? @default("México")

  personalPhone String?
  workPhone     String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  discounts         EmployeeDiscount[]
  documents         EmployeeDocument[] @relation("EmployeeDocuments")
  uploadedDocuments EmployeeDocument[] @relation("EmployeeDocumentsUploader")

  disciplinaryReports         DisciplinaryReport[] @relation("DisciplinaryReportEmployee")
  authoredDisciplinaryReports DisciplinaryReport[] @relation("DisciplinaryReportAuthor")

  // Baja lógica explícita (separada de `active`, que cubre soft-delete físico).
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivatedBy      User?     @relation("UserDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivationReason String?
  deactivatedByUsers User[]    @relation("UserDeactivator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTickets     Ticket[]                  @relation("TicketCreatedBy")
  assignedTickets    Ticket[]                  @relation("TicketAssignedTo")
  ticketAssignments  TicketAssignment[]
  assignmentComments TicketAssignmentComment[]
  ticketComments     TicketComment[]           @relation("TicketCommentAuthor")
  ticketHistory      TicketHistory[]           @relation("TicketHistoryAuthor")
  notifications      Notification[]
  attachments        TicketAttachment[]
  materialOutputs    MaterialOutput[]

  createdMovements       Movement[]        @relation("MovementCreatedBy")
  custodiedMovements     Movement[]        @relation("MovementCustodian")
  kitchenMovements       KitchenMovement[]
  purchaseOrdersCreated  PurchaseOrder[]   @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved PurchaseOrder[]   @relation("PurchaseOrderApprovedBy")
  createdInvoices        SupplierInvoice[] @relation("SupplierInvoiceCreator")
  custodiedLoans         Loan[]            @relation("LoanCustodian")
  custodiedReturns       LoanReturn[]      @relation("LoanReturnCustodian")

  sysConfigUpdates SysConfig[] @relation("SysConfigUpdater")

  // Control de acceso: el empleado es el sujeto del evento; el guardia, quien
  // lo registra. Relaciones con nombre para distinguir ambos roles.
  accessEventsAsEmployee AccessEvent[] @relation("AccessEventEmployee")
  accessEventsAsGuard    AccessEvent[] @relation("AccessEventGuard")

  scheduleAssignments        ScheduleAssignment[] @relation("ScheduleAssignee")
  createdScheduleAssignments ScheduleAssignment[] @relation("ScheduleAssignmentCreator")

  // Reloj checador: números del reloj vinculados a la persona y los vínculos
  // que capturó (relaciones con nombre para distinguir ambos roles).
  timeClockEmployees    TimeClockEmployee[] @relation("TimeClockEmployeeUser")
  createdTimeClockLinks TimeClockEmployee[] @relation("TimeClockEmployeeLinker")

  // Tiempo extra: decisiones de aprobación por persona y día, y las que capturó.
  overtimeApprovals OvertimeApproval[] @relation("OvertimeApprovalUser")
  overtimeDecisions OvertimeApproval[] @relation("OvertimeApprovalDecider")

  @@index([deactivatedAt])
  @@map("users")
}

model Gender {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("genders")
}

model BloodType {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("blood_types")
}

model DocumentType {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  /// Obligatorio en el expediente (el alta lo exige; el tablero de RH marca a quien le falta).
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[]

  @@map("document_types")
}

model EmployeeDiscount {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DiscountType
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, type])
  @@map("employee_discounts")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  storageKey     String       @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  uploadedBy     User         @relation("EmployeeDocumentsUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@index([documentTypeId])
  @@map("employee_documents")
}

model DeviceType {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  assetTagPrefix  String   @unique
  counter         Int      @default(0)
  active          Boolean  @default(true)
  useSerialNumber Boolean  @default(true)
  useMac          Boolean  @default(false)
  useIp           Boolean  @default(false)
  useHostname     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  devices Device[]

  @@map("device_types")
}

model Device {
  id          String     @id @default(uuid())
  typeId      String
  type        DeviceType @relation(fields: [typeId], references: [id])
  name        String
  brand       String
  model       String
  description String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  units         DeviceUnit[]
  movementItems MovementItem[]
  loanItems     LoanItem[]
  returnItems   LoanReturnItem[]

  @@unique([typeId, name, brand, model])
  @@index([typeId])
  @@map("devices")
}

model DeviceUnit {
  id           String           @id @default(uuid())
  deviceId     String
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  assetTag     String           @unique
  /// Índice único parcial (migración 20260927180000_device_units_serial_unique, SQL a
  /// mano porque Prisma no lo modela): `upper(btrim("serialNumber"))`, con los vacíos
  /// y nulos fuera del índice. La API normaliza la serie al crear y editar unidades.
  serialNumber String?
  macAddress   String?          @unique
  ip           String?
  hostname     String?
  area         String           @default("SISTEMAS")
  status       DeviceUnitStatus @default(AVAILABLE)
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  loanItemUnits     LoanItemUnit[]
  returnItemUnits   LoanReturnItemUnit[]
  materialOutputs   MaterialOutput[]
  movementItemUnits MovementItemUnit[]

  @@index([deviceId])
  @@index([status])
  @@index([departmentId])
  @@map("device_units")
}

model Movement {
  id           String         @id @default(uuid())
  type         MovementType
  date         DateTime       @default(now())
  createdById  String
  createdBy    User           @relation("MovementCreatedBy", fields: [createdById], references: [id])
  custodianId  String?
  custodian    User?          @relation("MovementCustodian", fields: [custodianId], references: [id])
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id])
  reason       String?
  notes        String?
  status       MovementStatus @default(ACTIVE)
  reversalOfId String?        @unique
  reversalOf   Movement?      @relation("Reversal", fields: [reversalOfId], references: [id])
  /// Idempotency-Key de la petición que lo creó (una petición repetida no duplica).
  requestId    String?        @unique
  reversals    Movement[]     @relation("Reversal")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items   MovementItem[]
  loan    Loan?
  returns LoanReturn[]

  @@index([date])
  @@index([type])
  @@index([status])
  @@map("movements")
}

model MovementItem {
  id         String         @id @default(uuid())
  movementId String
  movement   Movement       @relation(fields: [movementId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device         @relation(fields: [deviceId], references: [id])
  quantity   Int
  condition  ItemCondition?
  notes      String?

  units MovementItemUnit[]

  @@index([movementId])
  @@index([deviceId])
  @@map("movement_items")
}

model MovementItemUnit {
  id             String       @id @default(uuid())
  movementItemId String
  item           MovementItem @relation(fields: [movementItemId], references: [id], onDelete: Cascade)
  deviceUnitId   String
  deviceUnit     DeviceUnit   @relation(fields: [deviceUnitId], references: [id])

  @@unique([movementItemId, deviceUnitId])
  @@index([deviceUnitId])
  @@map("movement_item_units")
}

model Loan {
  id           String      @id @default(uuid())
  custodianId  String?
  custodian    User?       @relation("LoanCustodian", fields: [custodianId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])
  date         DateTime    @default(now())
  status       LoanStatus  @default(ACTIVE)
  movementId   String?     @unique
  movement     Movement?   @relation(fields: [movementId], references: [id])
  number       String      @unique
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items   LoanItem[]
  returns LoanReturn[]

  @@index([custodianId])
  @@index([status])
  @@map("loans")
}

model LoanItem {
  id               String  @id @default(uuid())
  loanId           String
  loan             Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
  deviceId         String
  device           Device  @relation(fields: [deviceId], references: [id])
  quantity         Int
  returnedQuantity Int     @default(0)
  notes            String?

  units       LoanItemUnit[]
  returnItems LoanReturnItem[]

  @@index([loanId])
  @@index([deviceId])
  @@map("loan_items")
}

/// Integridad (migración 20260927140000_inventory_integrity, SQL a mano porque
/// Prisma no los modela): índice único parcial `loan_item_units_open_unit_key`
/// — una unidad está en a lo más un préstamo abierto (`returned = false`) — y
/// CHECKs de cantidades en loan_items, loan_return_items y movement_items.
model LoanItemUnit {
  id           String     @id @default(uuid())
  loanItemId   String
  loanItem     LoanItem   @relation(fields: [loanItemId], references: [id], onDelete: Cascade)
  deviceUnitId String
  deviceUnit   DeviceUnit @relation(fields: [deviceUnitId], references: [id])
  returned     Boolean    @default(false)

  @@unique([loanItemId, deviceUnitId])
  @@index([deviceUnitId])
  @@map("loan_item_units")
}

model LoanReturn {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id])
  movementId  String   @unique
  movement    Movement @relation(fields: [movementId], references: [id])
  date        DateTime @default(now())
  custodianId String?
  custodian   User?    @relation("LoanReturnCustodian", fields: [custodianId], references: [id])
  number      String   @unique
  notes       String?

  items LoanReturnItem[]

  @@index([loanId])
  @@map("loan_returns")
}

model LoanReturnItem {
  id           String        @id @default(uuid())
  loanReturnId String
  loanReturn   LoanReturn    @relation(fields: [loanReturnId], references: [id], onDelete: Cascade)
  loanItemId   String
  loanItem     LoanItem      @relation(fields: [loanItemId], references: [id])
  deviceId     String
  device       Device        @relation(fields: [deviceId], references: [id])
  quantity     Int
  condition    ItemCondition
  notes        String?

  units LoanReturnItemUnit[]

  @@index([loanReturnId])
  @@index([loanItemId])
  @@map("loan_return_items")
}

model LoanReturnItemUnit {
  id               String         @id @default(uuid())
  loanReturnItemId String
  loanReturnItem   LoanReturnItem @relation(fields: [loanReturnItemId], references: [id], onDelete: Cascade)
  deviceUnitId     String
  deviceUnit       DeviceUnit     @relation(fields: [deviceUnitId], references: [id])

  @@unique([loanReturnItemId, deviceUnitId])
  @@index([deviceUnitId])
  @@map("loan_return_item_units")
}

model MaterialOutput {
  id             String                @id @default(uuid())
  date           DateTime              @default(now())
  description    String
  model          String?
  brand          String?
  project        String?
  quantity       Int                   @default(1)
  departmentName String
  userName       String
  notes          String?
  area           String                @default("Sistemas")
  reason         MaterialOutputReason?

  deviceUnitId String?
  deviceUnit   DeviceUnit? @relation(fields: [deviceUnitId], references: [id])

  registeredById String?
  registeredBy   User?   @relation(fields: [registeredById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([departmentName])
  @@index([deviceUnitId])
  @@index([area])
  @@map("material_outputs")
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  categoryId String?
  category   TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("TicketAssignedTo", fields: [assignedToId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  closedAt DateTime?
  closedBy String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    TicketComment[]
  history     TicketHistory[]
  assignments TicketAssignment[]
  attachments TicketAttachment[]

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([categoryId])
  @@map("tickets")
}

// Catálogo de categorías de ticket (antes enum TicketCategory).
model TicketCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]

  @@map("ticket_categories")
}

model TicketAssignment {
  id          String           @id @default(uuid())
  ticketId    String
  ticket      Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  title       String
  description String
  startDate   DateTime?
  dueDate     DateTime?
  status      AssignmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  comments    TicketAssignmentComment[]
  attachments TicketAttachment[]

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
  @@map("ticket_assignments")
}

model TicketAssignmentComment {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   TicketAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User             @relation(fields: [authorId], references: [id])
  text         String
  createdAt    DateTime         @default(now())

  @@index([assignmentId])
  @@map("ticket_assignment_comments")
}

model TicketAttachment {
  id           String            @id @default(uuid())
  ticketId     String?
  ticket       Ticket?           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   TicketAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageKey   String            @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  kind         String            @default("PHOTO")
  createdAt    DateTime          @default(now())

  @@index([ticketId])
  @@index([assignmentId])
  @@index([uploadedById])
  @@map("ticket_attachments")
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketCommentAuthor", fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_comments")
}

model TicketHistory {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      String
  detail    String?
  authorId  String?
  author    User?    @relation("TicketHistoryAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_history")
}

// Contador legado del sistema anterior (serie `F-MMTO-`). Solo lo usa el seed;
// ningún código lo lee en runtime.
model LegacySequence {
  id        String   @id @default("singleton")
  prefix    String   @default("F-MMTO-")
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("legacy_sequences")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  detail    String?
  ticketId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String
  entityId      String
  userId        String?
  userName      String?
  deviceId      String?
  deviceCode    String?
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DisciplinaryReport {
  id           String             @id @default(uuid())
  reason       DisciplinaryReason
  incidentDate DateTime           @db.Date
  description  String
  sanction     String?
  createdAt    DateTime           @default(now())

  userId      String
  user        User   @relation("DisciplinaryReportEmployee", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("DisciplinaryReportAuthor", fields: [createdById], references: [id])

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("disciplinary_reports")
}

// Configuración del sistema editable desde el panel de catálogos.
// Permite mover valores que antes vivían en `process.env` a una tabla
// gestionable por el ADMIN en tiempo de ejecución, con auditoría.
model SysConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SysConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt(sort: Desc)])
  @@map("sys_config")
}

// Estado de un registro de correo en la cola/bitácora de envíos.
enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Cola de correo + bitácora de envíos (outbox pattern). Cada trigger de
// notificación solo INSERTA una fila PENDING (sin SMTP en el request); un
// worker en background la drena con `sendEmail` y la marca SENT/FAILED.
// Las filas terminales no se borran: es el log de envíos consultable por
// el ADMIN. `attachments` guarda referencias S3 `[{storageKey, originalName,
// contentType}]`; el worker descarga el objeto al enviar.
model EmailLog {
  id            String         @id @default(cuid())
  to            String
  subject       String
  html          String
  attachments   Json? // [{storageKey, originalName, contentType}]
  action        String? // "user.deactivate", "ticket.comment", "document.uploaded", ...
  entityType    String?
  entityId      String?
  status        EmailLogStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([createdAt(sort: Desc)])
  @@map("email_logs")
}

// Catálogo de sitios/porterías. El "dónde" semántico del escaneo.
model Site {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String?  @unique
  active       Boolean  @default(true)
  latitude     Float?
  longitude    Float?
  radiusMeters Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessEvents AccessEvent[]

  @@map("sites")
}

// Evento de control de acceso. Cada escaneo es una fila inmutable; la jornada
// (entrada + salida) se deriva por consulta, nunca se materializa. La anulación
// es lógica (`voidedAt`/`voidedById`/`voidReason`): jamás se hace DELETE.
model AccessEvent {
  id              String          @id @default(uuid())
  type            AccessEventType
  // Hora autoritativa del servidor. El `deviceTimestamp` es solo auditoría.
  occurredAt      DateTime        @default(now())
  deviceTimestamp DateTime?

  employeeId             String
  employee               User    @relation("AccessEventEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  employeeNameSnapshot   String?
  employeeNumberSnapshot String?

  guardId String?
  guard   User?   @relation("AccessEventGuard", fields: [guardId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  locationSource    AccessLocationSource
  method            AccessMethod

  credentialVersion  Int?
  scannedPayloadHash String?

  // Idempotencia generada en el dispositivo.
  clientEventId String? @unique
  deviceId      String?
  deviceCode    String?

  notes String?

  // Anulación lógica.
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())

  @@index([occurredAt])
  @@index([employeeId, occurredAt])
  @@index([siteId])
  @@index([guardId])
  @@index([type])
  @@map("access_events")
}

// ---------------------------------------------------------------------------
// Horarios (administración) y asignación de horarios al personal.
// ---------------------------------------------------------------------------

/// Catálogo de horarios. La rejilla por día permite horarios que cambian por
/// día de la semana. Las horas son "de pared" (HH:mm), no instantes.
model Schedule {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)

  // Reglas de horas extra (minutos).
  entryToleranceMin Int     @default(10)
  exitToleranceMin  Int     @default(10)
  mealBreakMin      Int     @default(0)
  // Mínimo de tiempo extra para que cuente (0 = sin mínimo).
  minOvertimeMin    Int     @default(60)
  // Si la salida cae al día siguiente (turno nocturno).
  crossesMidnight   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days        ScheduleDay[]
  assignments ScheduleAssignment[]

  @@map("schedules")
}

/// Rejilla del horario por día de la semana (1=Lunes … 7=Domingo).
model ScheduleDay {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weekday    Int // 1..7

  startTime      String?
  endTime        String?
  // Turno partido (p. ej. camaristas/restaurante): segundo tramo opcional.
  splitStartTime String?
  splitEndTime   String?
  restDay        Boolean @default(false)

  @@unique([scheduleId, weekday])
  @@map("schedule_days")
}

/// Vigencia de un horario para una persona. El vigente es el que cubre "hoy".
model ScheduleAssignment {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("ScheduleAssignee", fields: [userId], references: [id])
  scheduleId String
  schedule   Schedule  @relation(fields: [scheduleId], references: [id])
  validFrom  DateTime
  validTo    DateTime?
  createdAt  DateTime  @default(now())

  createdById String?
  createdBy   User?   @relation("ScheduleAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, validFrom, validTo])
  @@index([scheduleId])
  @@map("schedule_assignments")
}

// ---------------------------------------------------------------------------
// Checador (reloj Hikvision). Copia de SOLO LECTURA de los eventos del equipo:
// la API nunca escribe en el reloj, solo lee su bitácora por ISAPI.
// ---------------------------------------------------------------------------

/// Cómo se identificó el empleado en el reloj (derivado del `minor` ISAPI).
enum PunchMethod {
  FACE
  FINGERPRINT
  CARD
  OTHER
}

/// Checada de un empleado identificado por el reloj. Inmutable: se copia tal
/// cual del equipo y nunca se edita. `serialNo` es el consecutivo del evento en
/// el reloj; con la serie del equipo identifica la checada, lo que hace
/// idempotente la sincronización.
model TimeClockPunch {
  id             String      @id @default(uuid())
  clockSerial    String
  serialNo       Int
  // Número y nombre tal como están dados de alta en el reloj.
  employeeNumber String
  name           String
  method         PunchMethod
  // Código `minor` del evento ISAPI (75 rostro, 38 huella, 1 tarjeta, …).
  minor          Int
  // Instante de la checada según el reloj del equipo.
  occurredAt     DateTime
  createdAt      DateTime    @default(now())

  @@unique([clockSerial, serialNo])
  @@index([occurredAt])
  @@index([employeeNumber, occurredAt])
  @@map("time_clock_punches")
}

/// Un reloj checador, identificado por su número de serie: cómo conectarse
/// (`url`, se da de alta desde la web) y hasta dónde se ha leído.
///
/// Cursor: todo evento con consecutivo `<= lastSerialNo` ya se procesó. Solo
/// avanza con una ventana o una corrida completas; si una corrida se corta, la
/// siguiente repite desde aquí y los duplicados se descartan por el `@@unique`
/// de `time_clock_punches`.
///
/// Dar de baja solo borra la `url`: el cursor, el nombre y las checadas se
/// quedan, y si el reloj se vuelve a dar de alta sigue desde donde iba.
model TimeClock {
  serialNumber     String    @id
  /// Para reconocerlo en pantalla (p. ej. "Entrada de personal").
  name             String?
  /// `http(s)://host[:puerto]`; `null` = dado de baja (no se sincroniza).
  url              String?   @unique
  /// Si sus checadas arman las entradas/salidas (y las horas extra). Los
  /// relojes de puertas de oficina se checan varias veces por turno: sus
  /// checadas se guardan, pero no cuentan como entrada o salida.
  countsAttendance Boolean   @default(true)
  model            String?
  lastSerialNo     Int       @default(0)
  syncedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("time_clocks")
}

/// Vínculo entre un empleado del reloj (su número en el equipo) y un usuario
/// del sistema. Es explícito: el número del reloj NO se compara tal cual con
/// `User.employeeNumber`, porque el reloj antepone el área (070562 ↔ 562) y el
/// número de nómina se repite entre áreas (040001 y 110001). Un usuario puede
/// tener más de un número de reloj (p. ej. si lo dieron de alta dos veces).
model TimeClockEmployee {
  employeeNumber String   @id
  userId         String
  user           User     @relation("TimeClockEmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  linkedById     String?
  linkedBy       User?    @relation("TimeClockEmployeeLinker", fields: [linkedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("time_clock_employees")
}

// ---------------------------------------------------------------------------
// Tiempo extra: decisión de aprobación por persona y día. La ausencia de fila
// significa PENDIENTE; solo se guardan las decisiones (aprobado/rechazado) con
// el snapshot del cálculo vigente al momento de decidir.
// ---------------------------------------------------------------------------

enum OvertimeApprovalStatus {
  APPROVED
  REJECTED
}

model OvertimeApproval {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation("OvertimeApprovalUser", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime               @db.Date
  status       OvertimeApprovalStatus
  // Snapshot del cálculo al momento de decidir (inmutable).
  extraMin     Int
  scheduleName String?
  scheduledMin Int?
  note         String?
  decidedById  String?
  decidedBy    User?                  @relation("OvertimeApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@map("overtime_approvals")
}

// ---------------------------------------------------------------------------
// Permisos: tanto el catálogo como la matriz rol → permiso → alcance viven en
// la base. El catálogo (`permissions`) es la fuente única de verdad de las
// claves; `role_permissions` las referencia por FK.
// ---------------------------------------------------------------------------

enum PermissionScope {
  NONE
  OWN
  AREA
  ALL
}

/// Roles del sistema (dinámicos). Antes era el enum `Role`; ahora es una tabla
/// administrable desde `/roles` (permiso `roles.manage`). `system` protege los
/// roles base (no se renombran ni borran); `staff` marca los roles con
/// expediente de personal (RH: checador, nómina, horas extra); `module` es el
/// dominio con el que se agrupan en la pantalla (p. ej. "RH", "Nómina").
model Role {
  key         String   @id
  name        String
  description String?
  module      String?
  staff       Boolean  @default(false)
  system      Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  userRoles   UserRole[]
  policyRoles PolicyRole[]

  @@index([module, sortOrder])
  @@map("roles")
}

/// Roles adicionales de un usuario (multi-rol). `User.role` sigue siendo el rol
/// principal; esta tabla agrega los demás. Los permisos efectivos son la unión
/// de todos los roles del usuario (gana el alcance mayor).
model UserRole {
  userId    String
  role      String
  createdAt DateTime @default(now())

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef Role @relation(fields: [role], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Catálogo de permisos (clave `module.action`). Fuente única de verdad en BD.
model Permission {
  key         String            @id
  module      String
  name        String
  description String?
  scopes      PermissionScope[]
  sensitive   Boolean           @default(false)
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  roles       RolePermission[]
  userPermissions UserPermission[]

  @@index([module, sortOrder])
  @@map("permissions")
}

/// Matriz rol → permiso → alcance. La ausencia de fila equivale a NONE; una
/// fila con NONE quita el permiso del rol de forma explícita (y evita que el
/// backfill del arranque lo reintroduzca). `permission` referencia el catálogo
/// en base (`permissions.key`) por FK con borrado/actualización en cascada.
model RolePermission {
  id         String          @id @default(uuid())
  role       String
  permission String
  scope      PermissionScope
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  roleRef       Role       @relation(fields: [role], references: [key], onDelete: Cascade, onUpdate: Cascade)
  permissionRef Permission @relation(fields: [permission], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([role, permission])
  @@map("role_permissions")
}

/// Excepción de permiso de un empleado (Fase 2). Reemplaza lo que dice su rol:
/// `scope = NONE` lo quita. Opcional: motivo y fecha de vencimiento.
model UserPermission {
  id          String          @id @default(uuid())
  userId      String
  permission  String
  scope       PermissionScope
  reason      String?
  expiresAt   DateTime?
  grantedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User       @relation("UserPermissionGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?      @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  permissionRef Permission @relation(fields: [permission], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

// ---------------------------------------------------------------------------
// Políticas ABAC dinámicas: reglas de contexto (estado, montos, segregación de
// funciones) evaluadas sobre una acción ya permitida por el RBAC. Se administran
// desde la web (`/roles` → Políticas). La primera regla que casa por prioridad
// decide; sin reglas que casen, se permite (el permiso ya lo autorizó).
// ---------------------------------------------------------------------------

enum PolicyEffect {
  ALLOW
  DENY
}

model Policy {
  id          String       @id @default(uuid())
  /// Clave estable de las políticas base sembradas (null en las creadas a mano).
  key         String?      @unique
  name        String
  description String?
  /// Acción (clave de permiso) sobre la que aplica, p. ej. `purchase_orders.approve`.
  action      String
  effect      PolicyEffect
  priority    Int          @default(100)
  active      Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy  User?             @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  conditions PolicyCondition[]
  roles      PolicyRole[]

  @@index([action, active, priority])
  @@map("policies")
}

/// Condición de una política: `field operator value` (p. ej. total gt 10000).
model PolicyCondition {
  id       String @id @default(uuid())
  policyId String
  field    String
  operator String
  value    String?

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("policy_conditions")
}

/// Roles a los que aplica la política. Sin filas = aplica a todos.
model PolicyRole {
  policyId String
  role     String

  policy  Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  roleRef Role   @relation(fields: [role], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@id([policyId, role])
  @@map("policy_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Almacén de cocina (KITCHEN_STORE.md). Existencias por lote con caducidad y
// cantidades decimales; una sola regla de kardex (kitchenLedgerDelta).
// ─────────────────────────────────────────────────────────────────────────────

/// CONSUMABLE baja por consumo (ingredientes, desechables); DURABLE solo por
/// merma (utensilios, vajilla).
enum KitchenItemKind {
  CONSUMABLE
  DURABLE
}

enum KitchenStorage {
  DRY
  REFRIGERATED
  FROZEN
}

enum KitchenMovementType {
  STOCK_IN
  CONSUMPTION
  WASTE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

enum KitchenWasteReason {
  EXPIRED
  SPOILED
  BREAKAGE
  LOSS
  OTHER
}

/// Estados de una orden de compra de cocina.
enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Catálogo de unidades de medida (kilogramo, pieza, caja…). Lo administra el
/// chef: puede agregar las que use. `whole` marca las discretas (pieza, caja):
/// el sugerido de reabastecimiento se redondea hacia arriba.
model KitchenUnit {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  whole     Boolean       @default(false)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     KitchenItem[]

  @@map("kitchen_units")
}

/// Categorías de cocina (Carnes, Lácteos, Abarrotes, Utensilios, Vajilla…).
model KitchenCategory {
  id        String        @id @default(uuid())
  name      String        @unique
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  items     KitchenItem[]

  @@map("kitchen_categories")
}

/// Proveedores: los usan los lotes hoy y los usarán órdenes de compra y facturas.
/// Centro de costo (área que absorbe el gasto). El departamento es opcional: no
/// todo centro de costo coincide con un departamento de la organización.
model CostCenter {
  id           String      @id @default(uuid())
  name         String      @unique
  code         String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([departmentId])
  @@map("cost_centers")
}

model Supplier {
  id               String   @id @default(uuid())
  /// Nombre comercial.
  name             String   @unique
  /// Razón social.
  legalName        String?
  /// RFC en mayúsculas (formato SAT), único.
  rfc              String?  @unique
  phone            String?
  email            String?
  website          String?
  // Ubicación
  street           String?
  neighborhood     String?
  postalCode       String?
  city             String?
  state            String?
  /// Referencias para llegar o para recibir.
  locationNotes    String?
  mapsUrl          String?
  // Condiciones comerciales
  /// Días de crédito (0 = contado).
  paymentTermsDays Int?
  /// Días que tarda en entregar desde que se envía la OC.
  leadTimeDays     Int?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contacts       SupplierContact[]
  items          SupplierItem[]
  lots           KitchenLot[]
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]

  @@map("suppliers")
}

/// Contacto de un proveedor (gerente, ventas, repartidor, cobranza…). A lo más
/// uno principal por proveedor (índice único parcial en la migración).
model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
  @@map("supplier_contacts")
}

/// Artículo que surte un proveedor y su presentación de compra: 1 `purchaseUnit`
/// (caja, bulto) = `factor` unidades base del artículo.
model SupplierItem {
  id              String      @id @default(uuid())
  supplierId      String
  supplier        Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId          String
  item            KitchenItem @relation(fields: [itemId], references: [id])
  /// Clave del producto en el catálogo del proveedor.
  supplierCode    String?
  purchaseUnit    String
  factor          Decimal     @db.Decimal(12, 3)
  /// Último precio por unidad de compra (lo actualiza la factura).
  lastUnitCost    Decimal?    @db.Decimal(12, 4)
  lastPurchasedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([supplierId, itemId])
  @@index([itemId])
  @@map("supplier_items")
}

model KitchenItem {
  id               String          @id @default(uuid())
  /// Código interno único (en mayúsculas).
  code             String          @unique
  name             String
  categoryId       String
  category         KitchenCategory @relation(fields: [categoryId], references: [id])
  kind             KitchenItemKind
  unitId           String
  unit             KitchenUnit     @relation(fields: [unitId], references: [id])
  /// Tasa de IVA con que se compra normalmente (se propone en la orden de compra).
  defaultTaxRateId String?
  defaultTaxRate   TaxRate?        @relation(fields: [defaultTaxRateId], references: [id])
  storage          KitchenStorage  @default(DRY)
  /// Perecedero: cada entrada exige fecha de caducidad.
  tracksExpiry     Boolean         @default(true)
  minStock         Decimal         @default(0) @db.Decimal(12, 3)
  maxStock         Decimal?        @db.Decimal(12, 3)
  notes            String?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lots               KitchenLot[]
  lines              KitchenMovementLine[]
  supplierItems      SupplierItem[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       SupplierInvoiceLine[]

  @@index([categoryId])
  @@index([unitId])
  @@index([name])
  @@map("kitchen_items")
}

/// Lote: nace con cada entrada. La existencia del artículo es la suma de sus lotes.
model KitchenLot {
  id         String      @id @default(uuid())
  itemId     String
  item       KitchenItem @relation(fields: [itemId], references: [id])
  /// Lote del proveedor o generado (L-AAAAMMDD-###).
  lotCode    String
  /// Día de caducidad (zona de la instalación); null en no perecederos.
  expiresAt  DateTime?   @db.Date
  receivedAt DateTime    @default(now())
  supplierId String?
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  unitCost   Decimal?    @db.Decimal(12, 4)
  quantityIn Decimal     @db.Decimal(12, 3)
  onHand     Decimal     @db.Decimal(12, 3)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  lines KitchenMovementLine[]

  @@unique([itemId, lotCode])
  @@index([itemId, expiresAt])
  @@index([expiresAt])
  @@map("kitchen_lots")
}

model KitchenMovement {
  id           String              @id @default(uuid())
  type         KitchenMovementType
  date         DateTime            @default(now())
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id])
  /// Remisión / folio del proveedor (hoy libre; después la orden de compra).
  reference    String?
  notes        String?
  wasteReason  KitchenWasteReason?
  status       MovementStatus      @default(ACTIVE)
  reversalOfId String?             @unique
  reversalOf   KitchenMovement?    @relation("KitchenReversal", fields: [reversalOfId], references: [id])
  reversals    KitchenMovement[]   @relation("KitchenReversal")
  /// Idempotency-Key de la petición que lo creó.
  requestId    String?             @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines           KitchenMovementLine[]
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])

  @@index([date])
  @@index([type])
  @@index([status])
  @@index([purchaseOrderId])
  @@map("kitchen_movements")
}

/// Renglón de un movimiento: siempre sobre un lote exacto; la cantidad es
/// positiva y el signo lo da el tipo del movimiento.
model KitchenMovementLine {
  id         String          @id @default(uuid())
  movementId String
  movement   KitchenMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  itemId     String
  item       KitchenItem     @relation(fields: [itemId], references: [id])
  lotId      String
  lot        KitchenLot      @relation(fields: [lotId], references: [id])
  quantity   Decimal         @db.Decimal(12, 3)
  unitCost   Decimal?        @db.Decimal(12, 4)

  @@index([movementId])
  @@index([itemId])
  @@index([lotId])
  @@map("kitchen_movement_lines")
}

/// Orden de compra de cocina (F3): se crea desde Reabastecimiento o a mano, la
/// aprueba gerencia y al recibirla genera el mismo `STOCK_IN` de v1 (ligado aquí).
model PurchaseOrder {
  id           String              @id @default(uuid())
  /// Folio consecutivo global (OC-0001).
  number       String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  /// Centro de costo que absorbe el gasto (opcional).
  costCenterId String?
  costCenter   CostCenter?         @relation(fields: [costCenterId], references: [id])
  /// Fecha esperada de entrega (día, opcional).
  expectedAt   DateTime?           @db.Date
  notes        String?
  createdById  String
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines     PurchaseOrderLine[]
  movements KitchenMovement[]
  invoices  SupplierInvoice[]

  @@index([supplierId])
  @@index([status])
  @@index([costCenterId])
  @@map("purchase_orders")
}

/// Renglón de una orden de compra: cantidad pedida, precio pactado (opcional) y
/// lo ya recibido (se va sumando con cada recepción).
model PurchaseOrderLine {
  id               String                @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId           String
  item             KitchenItem           @relation(fields: [itemId], references: [id])
  quantity         Decimal               @db.Decimal(12, 3)
  unitCost         Decimal?              @db.Decimal(12, 4)
  receivedQuantity Decimal               @default(0) @db.Decimal(12, 3)
  notes            String?
  /// Presentación con que se pidió (fotografía; quantity/unitCost siguen en unidad base).
  purchaseUnit     String?
  purchaseFactor   Decimal?              @db.Decimal(12, 3)
  purchaseQuantity Decimal?              @db.Decimal(12, 3)
  /// IVA del renglón: tasa del catálogo y su valor como fotografía (0.16).
  taxRateId        String?
  taxRateRef       TaxRate?              @relation(fields: [taxRateId], references: [id])
  taxRate          Decimal               @default(0) @db.Decimal(5, 4)
  invoiceLines     SupplierInvoiceLine[]

  @@unique([purchaseOrderId, itemId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

/// Factura de proveedor (F4): ligada (o no) a una orden de compra. Su costo
/// actualiza el costo de los lotes recibidos para valuar el inventario y medir
/// el costo de las mermas. El cotejo de tres vías (OC vs recibido vs facturado)
/// se calcula al vuelo, no se guarda.
model SupplierInvoice {
  id              String         @id @default(uuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  /// Folio de la factura del proveedor.
  number          String
  /// UUID del CFDI (opcional).
  uuid            String?
  date            DateTime       @db.Date
  subtotal        Decimal?       @db.Decimal(12, 2)
  tax             Decimal?       @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  status          MovementStatus @default(ACTIVE)
  notes           String?
  createdById     String
  createdBy       User           @relation("SupplierInvoiceCreator", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines SupplierInvoiceLine[]

  @@unique([supplierId, number])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("supplier_invoices")
}

/// Renglón de la factura; si apunta a un renglón de la OC, entra al cotejo.
model SupplierInvoiceLine {
  id                  String             @id @default(uuid())
  invoiceId           String
  invoice             SupplierInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId              String
  item                KitchenItem        @relation(fields: [itemId], references: [id])
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  quantity            Decimal            @db.Decimal(12, 3)
  unitCost            Decimal            @db.Decimal(12, 4)
  /// IVA del renglón facturado: tasa del catálogo y su valor como fotografía.
  taxRateId           String?
  taxRateRef          TaxRate?           @relation(fields: [taxRateId], references: [id])
  taxRate             Decimal            @default(0) @db.Decimal(5, 4)

  @@index([invoiceId])
  @@index([itemId])
  @@map("supplier_invoice_lines")
}

/// Catálogo de tasas de IVA (0%, 8% frontera, 16%). Los renglones de la orden
/// de compra guardan la tasa como fotografía: cambiar el catálogo no altera
/// órdenes anteriores.
model TaxRate {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Fracción: 0.16 = 16%.
  rate      Decimal  @unique @db.Decimal(5, 4)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              KitchenItem[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       SupplierInvoiceLine[]

  @@map("tax_rates")
}

/// Secuencia de folios por tipo de documento y año (OC-2026-0001). El `last` se
/// incrementa de forma atómica con `INSERT ... ON CONFLICT ... RETURNING`, así
/// que no hay carrera entre dos altas simultáneas. Reutilizable para facturas
/// internas y otros folios.
model DocumentSequence {
  type      String
  year      Int
  last      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([type, year])
  @@map("document_sequences")
}
